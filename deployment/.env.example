# Add these values into jenkins.
# Use strong, unique passwords. Do not commit .env.
whichbin-tls-pfx=SECRET FILE
whichbin-tls-keystore-password=replace-with-the-PFX-password

# production
whichbin-db-username=whichbin
whichbin-db-password=replace-with-a-strong-database-password
whichbin-db-root-password=replace-with-a-different-strong-root-password

whichbin-client-url=https://www.whichbin-orlando.org

# staging
whichbin-staging-db-username=whichbin
whichbin-staging-db-password=replace-with-a-strong-database-password
whichbin-staging-db-root-password=replace-with-a-different-strong-root-password

whichbin-staging-client-url=https://beta.whichbin-orlando.org

github-deployments-token=replace-with-github-token

# Add these values to Vercel's Environment Variables.
VITE_API_URL=https://api.whichbin-orlando.org/api/

# Add these values to GitHub
DISCORD_DEPLOYMENT_WEBHOOK=replace-with-discord-wehbook-token
